{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "ondas.cv" }],
      "destination": "https://www.ondas.cv/$1",
      "permanent": true
    },
    {
      "source": "/ondas-app",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cv-interilhas-pt",
      "destination": "/pt/cv-interilhas",
      "permanent": true
    },
    {
      "source": "/cv-interilhas-fr",
      "destination": "/fr/cv-interilhas",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/icon.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
